# Credenciais do deploy de produção (scripts/deploy-producao.sh).
# Copie para .env.deploy (ignorado pelo git) e preencha. Nunca faça commit
# do .env.deploy.
#
# Hospedagem: Hostinger, conta do Pint Network. Se você já tem o
# .env.deploy do pint-network-2.0, pode só reaproveitá-lo (sem copiar a senha):
#
#   source "$HOME/Projects/personal/pint-network-corp/pint-network-2.0/.env.deploy"
#   BF_SSH_HOST=$DEV_SSH_HOST
#   BF_SSH_USER=$DEV_SSH_USER
#   BF_SSH_PORT=$DEV_SSH_PORT
#   BF_SSH_PASS=$DEV_SSH_PASS

BF_SSH_HOST=
BF_SSH_USER=
BF_SSH_PORT=
BF_SSH_PASS=      # vazio se usar chave SSH
# Pasta do site em produção. O deploy só mexe dentro dela (e exige que termine
# em public_html/ferramentas).
BF_DESTINO=domains/brassagemforte.com.br/public_html/ferramentas
