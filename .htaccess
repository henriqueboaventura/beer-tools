# Só vale em PRODUÇÃO (brassagemforte.com.br/ferramentas/, servidor Apache/LiteSpeed
# da Hostinger). Esta pasta não tem relação com o WordPress do domínio: as regras
# daqui substituem as do WordPress dentro de /ferramentas/. O GitHub Pages (teste)
# ignora este arquivo.

RewriteEngine On

# Até a versão 1.11.1 as ferramentas ficavam em /ferramentas/ferramentas/<ferramenta>/.
# Links compartilhados e páginas já indexadas vão para o endereço novo com 301
# (o ?levedura=… e outros parâmetros seguem junto).
RewriteRule ^ferramentas/(.*)$ /ferramentas/$1 [R=301,L]

# Página "não encontrada" do próprio site (sem este .htaccess, o WordPress respondia).
ErrorDocument 404 /ferramentas/404.html
